{
  "name": "kasboek",
  "productName": "Kasboek",
  "version": "0.23.0",
  "description": "A simple, local-first budget app you can run with Claude.",
  "main": "./out/main/index.js",
  "author": "Kasboek",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "screenshots": "node scripts/screenshots/take.mjs",
    "icons": "node scripts/generate-icons.mjs && node scripts/generate-installer-art.mjs",
    "dist:win": "npm run build && npm run build:mcp && electron-builder --win",
    "dist:mac": "npm run build && npm run build:mcp && electron-builder --mac",
    "dist:linux": "npm run build && npm run build:mcp && electron-builder --linux",
    "check:i18n": "node scripts/check-i18n.mjs --strict",
    "build:mcp": "node scripts/build-mcp.mjs",
    "test:mcp": "cd tools/kasboek-mcp && go vet ./... && go test ./..."
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "hash-wasm": "4.12.0",
    "i18next": "^27.1.1",
    "lucide-react": "^1.72.0",
    "pdfjs-dist": "6.5.438",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
